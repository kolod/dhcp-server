<Window x:Class="DhcpServer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:DhcpServer.App.Localization"
        Style="{StaticResource AppWindow}"
        Title="{l:Loc App_Title}"
        Width="900" Height="640" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="{l:Loc Menu_Language}" ItemsSource="{Binding Languages}">
        <MenuItem.ItemContainerStyle>
          <Style TargetType="MenuItem">
            <Setter Property="Header" Value="{Binding NativeName}" />
            <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
            <Setter Property="Command" Value="{Binding DataContext.SelectLanguageCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="CommandParameter" Value="{Binding Code}" />
          </Style>
        </MenuItem.ItemContainerStyle>
      </MenuItem>
      <MenuItem Header="{l:Loc Menu_Help}">
        <MenuItem Header="{l:Loc Menu_About}" Click="About_Click" />
      </MenuItem>
    </Menu>

    <!-- State is shown as glyph + text, never by colour alone. -->
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding StateGlyph}" Margin="0,0,6,0" />
          <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
        </StackPanel>
      </StatusBarItem>
    </StatusBar>

    <Grid Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Unfinished restore from an earlier crash: Start is disabled until resolved. -->
      <Border Grid.Row="0" Margin="0,0,0,12" Padding="10"
              BorderThickness="1"
              BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
              Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"
              Visibility="{Binding RecoveryVisible, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="{Binding RecoveryText}" TextWrapping="Wrap"
                     Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="{l:Loc Recovery_Retry}" Command="{Binding RetryRecoveryCommand}" Padding="12,4" Margin="0,0,8,0" />
            <Button Content="{l:Loc Recovery_Discard}" Command="{Binding DiscardRecoveryCommand}" Padding="12,4" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{l:Loc Interface_Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox Grid.Column="1"
                  ItemsSource="{Binding Interfaces}"
                  SelectedItem="{Binding SelectedInterface}"
                  IsEnabled="{Binding CanChangeInterface}"
                  AutomationProperties.Name="{l:Loc Interface_Label}"
                  VerticalAlignment="Stretch" VerticalContentAlignment="Center" Margin="0,0,8,0">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding UnavailableReason}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
          <ComboBox.ItemContainerStyle>
            <Style TargetType="ComboBoxItem">
              <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
            </Style>
          </ComboBox.ItemContainerStyle>
        </ComboBox>
        <Button Grid.Column="2" Content="{Binding StartStopText}" Command="{Binding StartStopCommand}"
                MinWidth="96" Padding="12,4" IsDefault="True" />
      </Grid>

      <!-- Fixed address for this session; the previous settings come back when the server stops. -->
      <StackPanel Grid.Row="2" Margin="0,10,0,0" IsEnabled="{Binding CanChangeInterface}">
        <CheckBox Content="{l:Loc Address_UseFixed}"
                  IsChecked="{Binding Address.UseFixedAddress}"
                  IsEnabled="{Binding Address.CanToggle}" />
        <WrapPanel Margin="22,6,0,0">
          <StackPanel Margin="0,0,12,6">
            <TextBlock Text="{l:Loc Address_Address}" />
            <TextBox Text="{Binding Address.Address, UpdateSourceTrigger=PropertyChanged}" MinWidth="130"
                     IsReadOnly="{Binding Address.FieldsReadOnly}" AutomationProperties.Name="{l:Loc Address_Address}" />
          </StackPanel>
          <StackPanel Margin="0,0,12,6">
            <TextBlock Text="{l:Loc Address_Mask}" />
            <TextBox Text="{Binding Address.Mask, UpdateSourceTrigger=PropertyChanged}" MinWidth="130"
                     IsReadOnly="{Binding Address.FieldsReadOnly}" AutomationProperties.Name="{l:Loc Address_Mask}" />
          </StackPanel>
          <StackPanel Margin="0,0,12,6">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{l:Loc Address_Gateway}" />
              <TextBlock Text="{l:Loc Address_Optional}" Margin="4,0,0,0"
                         Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </StackPanel>
            <TextBox Text="{Binding Address.Gateway, UpdateSourceTrigger=PropertyChanged}" MinWidth="130"
                     IsReadOnly="{Binding Address.FieldsReadOnly}" AutomationProperties.Name="{l:Loc Address_Gateway}" />
          </StackPanel>
          <StackPanel Margin="0,0,12,6">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{l:Loc Address_Dns1}" />
              <TextBlock Text="{l:Loc Address_Optional}" Margin="4,0,0,0"
                         Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </StackPanel>
            <TextBox Text="{Binding Address.Dns1, UpdateSourceTrigger=PropertyChanged}" MinWidth="130"
                     IsReadOnly="{Binding Address.FieldsReadOnly}" AutomationProperties.Name="{l:Loc Address_Dns1}" />
          </StackPanel>
          <StackPanel Margin="0,0,12,6">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{l:Loc Address_Dns2}" />
              <TextBlock Text="{l:Loc Address_Optional}" Margin="4,0,0,0"
                         Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </StackPanel>
            <TextBox Text="{Binding Address.Dns2, UpdateSourceTrigger=PropertyChanged}" MinWidth="130"
                     IsReadOnly="{Binding Address.FieldsReadOnly}" AutomationProperties.Name="{l:Loc Address_Dns2}" />
          </StackPanel>
        </WrapPanel>
        <TextBlock Text="{Binding Address.FirstError}" TextWrapping="Wrap" Margin="22,0,0,0" />
      </StackPanel>

      <TextBlock Grid.Row="3" Text="{Binding DetailText}" TextWrapping="Wrap" Margin="0,10,0,0" />
      <TextBlock Grid.Row="4" Text="{Binding NoticeText}" TextWrapping="Wrap" Margin="0,6,0,0"
                 Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />

      <TextBlock Grid.Row="5" Text="{l:Loc Leases_Header}" FontWeight="SemiBold" Margin="0,14,0,6" />

      <Grid Grid.Row="6">
        <DataGrid ItemsSource="{Binding Leases}"
                  SelectedItem="{Binding SelectedLease}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  CanUserSortColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  ClipboardCopyMode="None"
                  AutomationProperties.Name="{l:Loc Leases_Header}">
          <DataGrid.InputBindings>
            <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyRowCommand}" />
          </DataGrid.InputBindings>
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
              <Setter Property="ContextMenu">
                <Setter.Value>
                  <ContextMenu>
                    <MenuItem Header="{l:Loc Menu_CopyIp}" Command="{Binding CopyIpCommand}" />
                    <MenuItem Header="{l:Loc Menu_CopyMac}" Command="{Binding CopyMacCommand}" />
                  </ContextMenu>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsInactive}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTextColumn Header="{l:Loc Column_IpAddress}" Binding="{Binding IpAddress}" Width="Auto" />
            <DataGridTextColumn Header="{l:Loc Column_MacAddress}" Binding="{Binding MacAddressText}" Width="Auto" />
            <DataGridTextColumn Header="{l:Loc Column_HostName}" Binding="{Binding HostName}" Width="*" />
            <DataGridTextColumn Header="{l:Loc Column_Start}" Binding="{Binding StartText}" Width="Auto" />
            <DataGridTextColumn Header="{l:Loc Column_Expires}" Binding="{Binding ExpiresText}" Width="Auto" />
            <DataGridTextColumn Header="{l:Loc Column_State}" Binding="{Binding StateText}" Width="Auto" />
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="{l:Loc Leases_Empty}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" IsHitTestVisible="False">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasLeases}" Value="False">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
