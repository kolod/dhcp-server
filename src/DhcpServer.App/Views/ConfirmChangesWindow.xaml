<Window x:Class="DhcpServer.App.Views.ConfirmChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:DhcpServer.App.Localization"
        Style="{StaticResource AppWindow}"
        Title="{l:Loc Confirm_Title}"
        SizeToContent="WidthAndHeight" MinWidth="460" MaxWidth="760"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="{Binding Intro}" TextWrapping="Wrap" Margin="0,0,0,10" />

    <!-- Table of current and new settings; rows that change are bold. -->
    <ListView Grid.Row="1" ItemsSource="{Binding Rows}" AutomationProperties.Name="{l:Loc Confirm_Title}"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="Focusable" Value="False" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Changed}" Value="True">
              <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.View>
        <GridView>
          <GridViewColumn Header="{l:Loc Confirm_Setting}" DisplayMemberBinding="{Binding Label}" />
          <GridViewColumn Header="{l:Loc Confirm_Current}" DisplayMemberBinding="{Binding Current}" />
          <GridViewColumn Header="{l:Loc Confirm_New}" DisplayMemberBinding="{Binding New}" />
        </GridView>
      </ListView.View>
    </ListView>

    <TextBlock Grid.Row="2" Text="{l:Loc Confirm_RestoreNote}" TextWrapping="Wrap" Margin="0,10,0,0" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="{l:Loc Confirm_Apply}" IsDefault="True" MinWidth="110" Padding="12,4" Margin="0,0,8,0" Click="Apply_Click" />
      <Button Content="{l:Loc Button_Cancel}" IsCancel="True" MinWidth="90" Padding="12,4" />
    </StackPanel>
  </Grid>
</Window>
