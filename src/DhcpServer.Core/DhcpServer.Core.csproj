<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UI-independent core. Built as a library only for unit tests and to guarantee that no WPF
    dependency creeps in. The shipped executable compiles these sources directly
    (see DhcpServer.App.csproj), so no DLL is deployed.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>DhcpServer.Core</RootNamespace>
    <AssemblyName>DhcpServer.Core</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

</Project>
